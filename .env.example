# Bu dosyayı ".env" adıyla kopyalayıp doldurun:  cp .env.example .env
# .env dosyasını kimseyle paylaşmayın ve GitHub'a yüklemeyin (şifre içerir).

# Sitenizin tam adresi (şifre sıfırlama bağlantıları bu adresle gönderilir)
APP_URL=https://kuranarastirmasi.duckdns.org

# E-posta (şifre sıfırlama için). Örnek: Gmail + "uygulama şifresi"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=ornek@gmail.com
SMTP_PASS=gmail-uygulama-sifresi
MAIL_FROM=Kuran Araştırması <ornek@gmail.com>
